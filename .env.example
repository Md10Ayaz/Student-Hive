# =====================================================================
# Student Hive — Environment Configuration Template
# =====================================================================
# Copy this file to .env and fill in your values

# Mode Switch: 'true' = Live Firebase, 'false' = Local Demo
VITE_USE_FIREBASE_LIVE=false

# Firebase Emulators: 'true' to use local emulators
VITE_USE_EMULATORS=false

# Firebase Project Config (replace with your own)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
